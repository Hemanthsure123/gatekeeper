# Gatekeeper environment template. Create your .env with `make init-env`; never commit .env.
# Secret keys are intentionally empty. "First needed" names the build prompt that first reads
# the key. `make env-check` shows which keys are set, grouped by that prompt.

# Runtime environment name: development | test | production. First needed: P01.
APP_ENV=development
# Log verbosity: DEBUG | INFO | WARNING | ERROR. First needed: P01.
LOG_LEVEL=INFO
# PostgreSQL role created by docker-compose. First needed: P01.
POSTGRES_USER=gatekeeper
# PostgreSQL password for that role (secret; generated by make init-env). First needed: P01.
POSTGRES_PASSWORD=
# PostgreSQL database created by docker-compose. First needed: P01.
POSTGRES_DB=gatekeeper
# Full Postgres DSN, contains the password (secret; built by make init-env). First needed: P01.
DATABASE_URL=
# Redis URL for queues and caching (local compose port 16379). First needed: P01.
REDIS_URL=redis://127.0.0.1:16379/0
# Model backend: ollama | gemini_api | vllm (default ollama). First needed: P02.
MODEL_BACKEND=ollama
# Ollama HTTP endpoint. First needed: P02.
OLLAMA_BASE_URL=http://localhost:11434
# Primary Ollama chat model tag (Gemma 4 family). First needed: P02.
OLLAMA_MODEL=
# Secondary/fallback Ollama model tag. First needed: P11.
OLLAMA_MODEL_SECONDARY=
# Ollama embedding model tag. First needed: P11.
OLLAMA_EMBED_MODEL=
# Optional, legacy single key for hosted Gemma via the Gemini API (secret); used only if GEMINI_API_KEYS is empty. First needed: P02.
GEMINI_API_KEY=
# Gemini API keys for hosted Gemma, comma-separated, rotated as a pool (secret; you add it). First needed: P05.
GEMINI_API_KEYS=
# Optional: key pool strategy, round_robin or primary_first (default round_robin). First needed: P05.
GEMINI_KEY_STRATEGY=
# Optional: first cooldown in seconds after a key is rate limited (default 30). First needed: P05.
GEMINI_KEY_COOLDOWN_BASE_S=
# Optional: longest key cooldown in seconds (default 3600). First needed: P05.
GEMINI_KEY_COOLDOWN_MAX_S=
# Optional: longest wait for a cooling key before the job backs off (default 60). First needed: P05.
GEMINI_MAX_WAIT_FOR_KEY_S=
# Optional: true allows reviewing private repos with a hosted model (default false). First needed: P05.
ALLOW_PRIVATE_REPOS_ON_HOSTED_MODEL=
# Optional: hosted Gemma primary model id (used only with GEMINI_API_KEY). First needed: P02.
GEMMA_MODEL_PRIMARY=
# Optional: hosted Gemma secondary model id (used only with GEMINI_API_KEY). First needed: P02.
GEMMA_MODEL_SECONDARY=
# Optional: seconds before a model call times out (default 120). First needed: P02.
MODEL_TIMEOUT_S=
# Optional: retries for retryable model failures (default 2). First needed: P02.
MODEL_MAX_RETRIES=
# Optional: concurrent model calls per process (default 1). First needed: P02.
MODEL_MAX_CONCURRENCY=
# Optional: seconds a validated model response stays cached in Redis (default 604800). First needed: P02.
MODEL_CACHE_TTL_S=
# Optional: Ollama context window in tokens sent as num_ctx (default 16384). First needed: P02.
OLLAMA_NUM_CTX=
# Optional: how long Ollama keeps the model loaded, e.g. 10m, 1h, -1 (default 10m). First needed: P02.
OLLAMA_KEEP_ALIVE=
# Personal GitHub token for local development reads (secret; you add it). First needed: P03.
GITHUB_TOKEN_DEV=
# Webhook relay URL (e.g. smee.io channel) that forwards GitHub events to localhost. First needed: P03.
WEBHOOK_PROXY_URL=
# GitHub App numeric ID (you add it). First needed: P03.
GITHUB_APP_ID=
# Path to the GitHub App private key .pem, kept under secrets/ (you add it). First needed: P03.
GITHUB_APP_PRIVATE_KEY_PATH=
# HMAC secret for verifying GitHub webhook signatures (secret; generated). First needed: P03.
GITHUB_WEBHOOK_SECRET=
# Optional: comma-separated owner/name repos Gatekeeper may act on; empty allows all in development, none in production. First needed: P03.
GATEKEEPER_ALLOWED_REPOS=
# Optional: GitHub REST API base URL (default https://api.github.com). First needed: P03.
GITHUB_API_BASE_URL=
# Optional: largest webhook body accepted, in bytes (default 10485760). First needed: P03.
WEBHOOK_MAX_BODY_BYTES=
# Optional: seconds a queued job may run before it is abandoned (default 1800). First needed: P03.
JOB_TIMEOUT_S=
# Optional: seconds between worker polls for new jobs (default 1). First needed: P03.
WORKER_POLL_INTERVAL_S=
# Optional: seconds a worker's claim on a job lasts between heartbeats (default 120). First needed: P03.
JOB_LEASE_S=
# Optional: attempts before a retryable job becomes dead (default 3). First needed: P03.
JOB_MAX_ATTEMPTS=
# Optional: total patch bytes kept per pull request before the diff is marked truncated (default 300000). First needed: P03.
DIFF_MAX_BYTES=
# Optional: files fetched per pull request before the file list is marked truncated (default 300). First needed: P03.
PR_MAX_FILES=
# Optional: confidence below which the review abstains to "needs a human look" (default 0.6). First needed: P04.
REVIEW_ABSTAIN_THRESHOLD=
# Optional: minimum confidence to keep a "likely low value" verdict (default 0.75). First needed: P04.
REVIEW_NEGATIVE_MIN_CONFIDENCE=
# Optional: most evidence items the model may cite (default 5). First needed: P04.
REVIEW_MAX_EVIDENCE=
# Optional: output token budget for the review call (default 800). First needed: P04.
REVIEW_MAX_OUTPUT_TOKENS=
# Optional: diff token budget (default OLLAMA_NUM_CTX - REVIEW_MAX_OUTPUT_TOKENS - 2048, i.e. 13536). First needed: P04.
REVIEW_DIFF_TOKEN_BUDGET=
# Bearer token for local admin API access (secret; generated). First needed: P14.
GATEKEEPER_ADMIN_TOKEN=
# Key for signing dashboard sessions (secret; generated). First needed: P14.
SESSION_SECRET=
# Optional: Hugging Face token for gated model or dataset downloads (secret). First needed: P07.
HF_TOKEN=
# OpenTelemetry OTLP collector endpoint; empty disables export. First needed: P16.
OTEL_EXPORTER_OTLP_ENDPOINT=
