# Gatekeeper environment template. Create your .env with `make init-env`; never commit .env.
# Secret keys are intentionally empty. "First needed" names the prompt (P00) or, where the
# roadmap has no number yet, the component whose prompt will first read the key.

# Runtime environment name: development | test | production. First needed: backend config prompt.
APP_ENV=development
# Log verbosity: DEBUG | INFO | WARNING | ERROR. First needed: backend config prompt.
LOG_LEVEL=INFO
# PostgreSQL role created by docker-compose. First needed: P00 (make up).
POSTGRES_USER=gatekeeper
# PostgreSQL password for that role (secret; generated by make init-env). First needed: P00 (make up).
POSTGRES_PASSWORD=
# PostgreSQL database created by docker-compose. First needed: P00 (make up).
POSTGRES_DB=gatekeeper
# Full Postgres DSN, contains the password (secret; built by make init-env). First needed: persistence/audit-trail prompt.
DATABASE_URL=
# Redis URL for queues and caching (local compose port 16379). First needed: item-router/queue prompt.
REDIS_URL=redis://127.0.0.1:16379/0
# Model backend selector; "ollama" is the only backend for now. First needed: model-adapter prompt.
MODEL_BACKEND=ollama
# Ollama HTTP endpoint. First needed: P00 (make doctor).
OLLAMA_BASE_URL=http://localhost:11434
# Primary Ollama chat model tag (Gemma 4 family). First needed: model-adapter prompt.
OLLAMA_MODEL=
# Secondary/fallback Ollama model tag. First needed: model-adapter prompt.
OLLAMA_MODEL_SECONDARY=
# Ollama embedding model tag. First needed: evidence-retrieval prompt.
OLLAMA_EMBED_MODEL=
# Optional: Google AI Studio key for hosted Gemma via the Gemini API (secret). First needed: model-adapter prompt.
GEMINI_API_KEY=
# Optional: hosted Gemma primary model id (used only with GEMINI_API_KEY). First needed: model-adapter prompt.
GEMMA_MODEL_PRIMARY=
# Optional: hosted Gemma secondary model id (used only with GEMINI_API_KEY). First needed: model-adapter prompt.
GEMMA_MODEL_SECONDARY=
# Personal GitHub token for local development reads (secret; you add it). First needed: GitHub-integration prompt.
GITHUB_TOKEN_DEV=
# Webhook relay URL (e.g. smee.io channel) that forwards GitHub events to localhost. First needed: gateway prompt.
WEBHOOK_PROXY_URL=
# GitHub App numeric ID (you add it). First needed: GitHub App/gateway prompt.
GITHUB_APP_ID=
# Path to the GitHub App private key .pem, kept under secrets/ (you add it). First needed: GitHub App/gateway prompt.
GITHUB_APP_PRIVATE_KEY_PATH=
# HMAC secret for verifying GitHub webhook signatures (secret; generated). First needed: gateway prompt.
GITHUB_WEBHOOK_SECRET=
# Bearer token for local admin API access (secret; generated). First needed: admin API/dashboard prompt.
GATEKEEPER_ADMIN_TOKEN=
# Key for signing dashboard sessions (secret; generated). First needed: dashboard prompt.
SESSION_SECRET=
# Optional: Hugging Face token for gated model or dataset downloads (secret). First needed: eval prompt.
HF_TOKEN=
# OpenTelemetry OTLP collector endpoint; empty disables export. First needed: observability prompt.
OTEL_EXPORTER_OTLP_ENDPOINT=
