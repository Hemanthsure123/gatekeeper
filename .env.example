# Gatekeeper environment template. Create your .env with `make init-env`; never commit .env.
# Secret keys are intentionally empty. "First needed" names the build prompt that first reads
# the key. `make env-check` shows which keys are set, grouped by that prompt.

# Runtime environment name: development | test | production. First needed: P01.
APP_ENV=development
# Log verbosity: DEBUG | INFO | WARNING | ERROR. First needed: P01.
LOG_LEVEL=INFO
# PostgreSQL role created by docker-compose. First needed: P01.
POSTGRES_USER=gatekeeper
# PostgreSQL password for that role (secret; generated by make init-env). First needed: P01.
POSTGRES_PASSWORD=
# PostgreSQL database created by docker-compose. First needed: P01.
POSTGRES_DB=gatekeeper
# Full Postgres DSN, contains the password (secret; built by make init-env). First needed: P01.
DATABASE_URL=
# Redis URL for queues and caching (local compose port 16379). First needed: P01.
REDIS_URL=redis://127.0.0.1:16379/0
# Model backend: ollama | gemini_api | vllm (default ollama). First needed: P02.
MODEL_BACKEND=ollama
# Ollama HTTP endpoint. First needed: P02.
OLLAMA_BASE_URL=http://localhost:11434
# Primary Ollama chat model tag (Gemma 4 family). First needed: P02.
OLLAMA_MODEL=
# Secondary/fallback Ollama model tag. First needed: P11.
OLLAMA_MODEL_SECONDARY=
# Ollama embedding model tag. First needed: P11.
OLLAMA_EMBED_MODEL=
# Optional: Google AI Studio key for hosted Gemma via the Gemini API (secret). First needed: P02.
GEMINI_API_KEY=
# Optional: hosted Gemma primary model id (used only with GEMINI_API_KEY). First needed: P02.
GEMMA_MODEL_PRIMARY=
# Optional: hosted Gemma secondary model id (used only with GEMINI_API_KEY). First needed: P02.
GEMMA_MODEL_SECONDARY=
# Optional: seconds before a model call times out (default 120). First needed: P02.
MODEL_TIMEOUT_S=
# Optional: retries for retryable model failures (default 2). First needed: P02.
MODEL_MAX_RETRIES=
# Optional: concurrent model calls per process (default 1). First needed: P02.
MODEL_MAX_CONCURRENCY=
# Optional: seconds a validated model response stays cached in Redis (default 604800). First needed: P02.
MODEL_CACHE_TTL_S=
# Optional: Ollama context window in tokens sent as num_ctx (default 16384). First needed: P02.
OLLAMA_NUM_CTX=
# Optional: how long Ollama keeps the model loaded, e.g. 10m, 1h, -1 (default 10m). First needed: P02.
OLLAMA_KEEP_ALIVE=
# Personal GitHub token for local development reads (secret; you add it). First needed: P03.
GITHUB_TOKEN_DEV=
# Webhook relay URL (e.g. smee.io channel) that forwards GitHub events to localhost. First needed: P03.
WEBHOOK_PROXY_URL=
# GitHub App numeric ID (you add it). First needed: P03.
GITHUB_APP_ID=
# Path to the GitHub App private key .pem, kept under secrets/ (you add it). First needed: P03.
GITHUB_APP_PRIVATE_KEY_PATH=
# HMAC secret for verifying GitHub webhook signatures (secret; generated). First needed: P03.
GITHUB_WEBHOOK_SECRET=
# Bearer token for local admin API access (secret; generated). First needed: P14.
GATEKEEPER_ADMIN_TOKEN=
# Key for signing dashboard sessions (secret; generated). First needed: P14.
SESSION_SECRET=
# Optional: Hugging Face token for gated model or dataset downloads (secret). First needed: P07.
HF_TOKEN=
# OpenTelemetry OTLP collector endpoint; empty disables export. First needed: P16.
OTEL_EXPORTER_OTLP_ENDPOINT=
